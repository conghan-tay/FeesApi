{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug E2E Test",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}/e2e",
      "args": [
        "-test.v",
        "-test.run",
        "TestFeesLifecycleE2E",
        "-test.count=1"
      ],
      "env": {
        "PAVEBANK_E2E": "1",
        "PAVEBANK_API_BASE_URL": "http://localhost:4000"
      }
    },
    {
      "name": "Attach to Encore Server",
      "type": "go",
      "request": "attach",
      "mode": "local",
      "processId": "${command:pickProcess}"
    }
  ]
}
